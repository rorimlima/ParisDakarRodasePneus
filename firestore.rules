rules_version = '2';

// =============================================================================
// Paris Dakar Rodas e Pneus — Firestore Security Rules
//
// Princípios:
//  1. Negar por padrão. A última regra do arquivo fecha tudo que não foi liberado.
//  2. Papel vem de custom claim assinado pelo Firebase Auth, nunca de campo no
//     documento — documento o cliente escreve, claim não.
//  3. Custo (ValorReposicao) mora em coleção separada. Firestore não filtra campo
//     na leitura: se custo estivesse em `products`, qualquer visitante leria a
//     margem da empresa com três linhas de SDK no console do navegador.
//  4. A invariante "estoque zerado ⇒ fora do site" é validada aqui também. Não
//     basta o app respeitar: a regra recusa a escrita que a violaria.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identidade e papéis
    // ---------------------------------------------------------------------

    function autenticado() {
      return request.auth != null;
    }

    function papel() {
      return request.auth != null && request.auth.token.role is string
        ? request.auth.token.role
        : 'visitante';
    }

    function ehSenior()   { return papel() == 'senior'; }
    function ehGerencia() { return papel() == 'gerencia'; }
    function ehAdmin()    { return papel() == 'admin'; }

    /** Opera o catálogo. */
    function equipeAdministrativa() {
      return ehSenior() || ehGerencia() || ehAdmin();
    }

    /** Enxerga ValorReposicao, margem e simulação de desconto com custo. */
    function acessoACusto() {
      return ehSenior() || ehGerencia();
    }

    /** Conta com e-mail verificado — exigido para qualquer ação administrativa. */
    function contaConfiavel() {
      return autenticado() && request.auth.token.email_verified == true;
    }

    function operadorDoCatalogo() {
      return contaConfiavel() && equipeAdministrativa();
    }

    // ---------------------------------------------------------------------
    // Helpers de validação
    // ---------------------------------------------------------------------

    function texto(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    function numeroNaoNegativo(valor) {
      return valor is number && valor >= 0;
    }

    function campos() {
      return request.resource.data;
    }

    // ---------------------------------------------------------------------
    // products — catálogo público
    //
    // Leitura pública restrita a ativo == true. Vale para `get` e para `list`:
    // uma query sem o filtro `where('ativo','==',true)` é recusada inteira, então
    // ninguém enumera produto desativado nem preço de item fora de linha.
    // ---------------------------------------------------------------------

    match /products/{codigo} {

      allow read: if resource.data.ativo == true || operadorDoCatalogo();

      /**
       * Invariante de publicação, replicada da aplicação e da Cloud Function:
       *   ativo === ativoManual && quantidade > 0
       * Produto sem estoque não vai ao ar nem por escrita direta via SDK.
       */
      function publicacaoCoerente() {
        return campos().ativo is bool
          && campos().ativoManual is bool
          && numeroNaoNegativo(campos().quantidade)
          && campos().ativo == (campos().ativoManual && campos().quantidade > 0);
      }

      function produtoValido() {
        return texto(campos().codigo, 40)
          && campos().codigo == codigo
          && texto(campos().descricao, 200)
          && campos().descricao.size() > 0
          && texto(campos().tipoProduto, 80)
          && texto(campos().categoriaSlug, 60)
          && texto(campos().unidade, 6)
          && numeroNaoNegativo(campos().valorVenda)
          && campos().valorVenda <= 10000000
          && campos().quantidade <= 1000000
          && campos().fichaTecnica is map
          && campos().marcasAtendidas is list
          && campos().marcasAtendidas.size() <= 40
          && campos().modelosAtendidos is list
          && campos().modelosAtendidos.size() <= 80
          && campos().imagens is list
          && campos().imagens.size() <= 12
          && publicacaoCoerente()
          // Custo jamais trafega no documento público, nem por engano de código.
          && !('valorReposicao' in campos())
          && !('valorPublicoSugerido' in campos())
          && !('valorGarantia' in campos())
          && !('custo' in campos())
          && !('margem' in campos());
      }

      allow create: if operadorDoCatalogo() && produtoValido();
      allow update: if operadorDoCatalogo() && produtoValido();
      // Excluir produto apaga histórico de catálogo: só sênior e gerência.
      allow delete: if contaConfiavel() && (ehSenior() || ehGerencia());
    }

    // ---------------------------------------------------------------------
    // productCosts — ValorReposicao. Perímetro fechado.
    // ---------------------------------------------------------------------

    match /productCosts/{codigo} {
      allow read: if contaConfiavel() && acessoACusto();

      allow create, update: if contaConfiavel()
        && equipeAdministrativa()
        && campos().codigo == codigo
        && numeroNaoNegativo(campos().valorReposicao)
        && campos().valorReposicao <= 10000000;

      allow delete: if contaConfiavel() && (ehSenior() || ehGerencia());
    }

    // ---------------------------------------------------------------------
    // categories — taxonomia e schema de ficha técnica
    // ---------------------------------------------------------------------

    match /categories/{slug} {
      allow read: if true;

      allow create, update: if operadorDoCatalogo()
        && campos().slug == slug
        && texto(campos().nomeExibicao, 80)
        && texto(campos().nomeOriginal, 80)
        && campos().visivelNoSite is bool
        && campos().campos is list
        && campos().campos.size() <= 60;

      allow delete: if contaConfiavel() && ehSenior();
    }

    // ---------------------------------------------------------------------
    // imports — relatórios de importação (contêm quantidades e preços)
    // ---------------------------------------------------------------------

    match /imports/{importId} {
      allow read: if operadorDoCatalogo();
      allow create: if operadorDoCatalogo()
        && campos().id == importId
        && texto(campos().arquivo, 120)
        && campos().totalLinhas is number;
      // Relatório é registro de auditoria: escreve uma vez, não se edita nem se apaga.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // settings — textos e contatos do site
    // ---------------------------------------------------------------------

    match /settings/{documento} {
      allow read: if true;
      allow write: if contaConfiavel() && (ehSenior() || ehGerencia());
    }

    // ---------------------------------------------------------------------
    // users — perfis. O papel vive no custom claim; o campo aqui é só espelho
    // para exibição e NÃO concede permissão nenhuma.
    // ---------------------------------------------------------------------

    match /users/{uid} {
      allow read: if contaConfiavel() && (request.auth.uid == uid || equipeAdministrativa());

      // O próprio usuário mantém nome e telefone. Nunca o papel.
      allow update: if contaConfiavel()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nome', 'telefone', 'atualizadoEm']);

      // Criação e mudança de papel só pela Cloud Function (Admin SDK ignora estas rules).
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Clientes
    // ---------------------------------------------------------------------

    match /clientsCpf/{uid} {
      allow read: if contaConfiavel() && (request.auth.uid == uid || equipeAdministrativa());
      allow create: if contaConfiavel()
        && request.auth.uid == uid
        && texto(campos().nomeCompleto, 120)
        && texto(campos().cpf, 14)
        && texto(campos().email, 160);
      allow update: if contaConfiavel() && (request.auth.uid == uid || equipeAdministrativa());
      allow delete: if contaConfiavel() && ehSenior();
    }

    match /clientsCnpj/{uid} {
      allow read: if contaConfiavel() && (request.auth.uid == uid || equipeAdministrativa());
      allow create: if contaConfiavel()
        && request.auth.uid == uid
        && texto(campos().razaoSocial, 160)
        && texto(campos().cnpj, 20)
        // Desconto B2B é definido pela gerência, não declarado pelo cliente no cadastro.
        && !('percentualDesconto' in campos())
        && !('aprovado' in campos());
      allow update: if contaConfiavel() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['telefone', 'email', 'endereco', 'nomeFantasia', 'atualizadoEm']))
        || (equipeAdministrativa())
      );
      allow delete: if contaConfiavel() && ehSenior();
    }

    // ---------------------------------------------------------------------
    // inquiries — pedidos de cotação vindos do site
    // ---------------------------------------------------------------------

    match /inquiries/{id} {
      allow read: if operadorDoCatalogo();

      allow create: if texto(campos().nomeCliente, 120)
        && texto(campos().telefone, 24)
        && texto(campos().codigoProduto, 40)
        && texto(campos().observacoes, 600)
        && campos().status == 'Novo'
        // Sem preço embutido pelo cliente: a proposta é recalculada no servidor.
        && !('valorNegociado' in campos())
        && !('percentualDesconto' in campos());

      allow update: if operadorDoCatalogo();
      allow delete: if contaConfiavel() && ehSenior();
    }

    // ---------------------------------------------------------------------
    // auditLog — escrito apenas pelo Admin SDK nas Cloud Functions
    // ---------------------------------------------------------------------

    match /auditLog/{id} {
      allow read: if contaConfiavel() && (ehSenior() || ehGerencia());
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Fecha o resto
    // ---------------------------------------------------------------------

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
