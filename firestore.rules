rules_version = '2';

// =============================================================================
// Paris Dakar Rodas e Pneus — Firestore Security Rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Regras de Leitura e Escrita do Catálogo, Custos, Categorias, Configurações e Leads
    match /products/{codigo} {
      allow read, write: if true;
    }

    match /productCosts/{codigo} {
      allow read, write: if true;
    }

    match /categories/{slug} {
      allow read, write: if true;
    }

    match /imports/{importId} {
      allow read, write: if true;
    }

    match /settings/{documento} {
      allow read, write: if true;
    }

    match /users/{uid} {
      allow read, write: if true;
    }

    match /clientsCpf/{uid} {
      allow read, write: if true;
    }

    match /clientsCnpj/{uid} {
      allow read, write: if true;
    }

    match /inquiries/{id} {
      allow read, write: if true;
    }

    match /auditLog/{id} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{documento=**} {
      allow read, write: if true;
    }
  }
}
