rules_version = '2';

// =============================================================================
// Paris Dakar Rodas e Pneus — Firestore Security Rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return isAuthenticated() && 'role' in request.auth.token ? request.auth.token.role : 'visitante';
    }

    function isAdmin() {
      return getUserRole() in ['admin', 'senior', 'gerencia'];
    }

    function isSenior() {
      return getUserRole() in ['senior', 'gerencia'];
    }

    // Regras de Leitura e Escrita do Catálogo, Custos, Categorias, Configurações e Leads
    match /products/{codigo} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productCosts/{codigo} {
      allow read, write: if isSenior();
    }

    match /categories/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /imports/{importId} {
      allow read: if isSenior();
      allow write: if isAdmin();
    }

    match /settings/{documento} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }

    match /clientsCpf/{email} {
      allow read, write: if isAuthenticated() && (request.auth.token.email.lower() == email.lower() || request.auth.uid == email || isAdmin());
    }

    match /clientsCnpj/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }

    match /inquiries/{id} {
      allow create: if true; // Permite envio de cotações por visitantes
      allow read, update, delete: if isAdmin();
    }

    match /auditLog/{id} {
      allow read, write: if isAdmin();
    }

    // Default Fallback
    match /{documento=**} {
      allow read, write: if isAdmin();
    }
  }
}
