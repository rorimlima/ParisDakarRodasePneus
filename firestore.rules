rules_version = '2';

/**
 * Paris Dakar Rodas e Pneus — regras de acesso ao Firestore.
 *
 * Postura: negar tudo por padrão.
 *
 * O site nunca fala direto com o Firestore; todo acesso passa pela API
 * Express, que usa o Admin SDK e roda com credencial de serviço (o Admin SDK
 * ignora estas regras por design). Então qualquer leitura ou escrita que
 * chegue aqui vem de um cliente com a chave pública da Web — exatamente o
 * que não deve poder tocar no catálogo, nos cadastros e nos leads.
 *
 * Se um dia o front for falar direto com o Firestore, abra regra por
 * coleção com condição explícita. Não relaxe esta regra global.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
