# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Origens Autorizadas do Frontend (CORS)
ALLOWED_ORIGINS=https://parisdakarrodas.vercel.app,https://parisdakarrodas-admin.vercel.app,http://localhost:3000,http://localhost:5173

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=paris-dakar-rodas-pneus
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@paris-dakar-rodas-pneus.iam.gserviceaccount.com
# Observação: a chave privada deve estar com as quebras de linha \n formatadas corretamente
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Antigravity Database Configuration (ou Firestore/Postgres/DB Provider)
DATABASE_URL="postgres://user:password@localhost:5432/parisdakar_db"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


# --- Migração do catálogo para o Firestore ---
# Base da API no frontend. Vazio = mesmo domínio (o Hosting reescreve /api/**
# para a Cloud Function). Em dev local aponte para o servidor Express.
VITE_API_BASE_URL=""

# Chave de corte: com "true" a loja lê o catálogo da API em vez do localStorage.
# Só ligue depois de confirmar em produção que GET /health/db responde "ok" e
# que o catálogo foi semeado (npm run seed:catalog). Com o backend vazio ou
# fora do ar, a vitrine fica sem produtos.
VITE_USE_API_CATALOG="false"

# Emulador do Firestore para desenvolvimento local (npm run emulator).
# Quando definido, o Admin SDK ignora as credenciais acima.
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
