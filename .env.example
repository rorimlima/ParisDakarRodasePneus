# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Origens Autorizadas do Frontend (CORS)
ALLOWED_ORIGINS=https://parisdakarrodas.vercel.app,https://parisdakarrodas-admin.vercel.app,http://localhost:3000,http://localhost:5173

# Firebase Web SDK (frontend / Vite)
# Copie os valores em: Console do Firebase > Configurações do projeto > Seus apps > App da Web.
# Estas chaves são públicas por natureza — quem protege os dados são as Security Rules.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="paris-dakar-rodas-pneus.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="paris-dakar-rodas-pneus"
VITE_FIREBASE_STORAGE_BUCKET="paris-dakar-rodas-pneus.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=paris-dakar-rodas-pneus
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@paris-dakar-rodas-pneus.iam.gserviceaccount.com
# Observação: a chave privada deve estar com as quebras de linha \n formatadas corretamente
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Antigravity Database Configuration (ou Firestore/Postgres/DB Provider)
DATABASE_URL="postgres://user:password@localhost:5432/parisdakar_db"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

