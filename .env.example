# =============================================================================
# Paris Dakar Rodas e Pneus — variáveis de ambiente
#
# Copie para .env.local e preencha com os dados do seu projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → Web).
#
# Estas chaves VITE_* vão para o bundle do navegador e são públicas por design.
# Quem protege os dados são firestore.rules e storage.rules, não o segredo delas.
# Nunca coloque aqui service account, chave privada ou token de servidor.
# =============================================================================

VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="parisdakar-rodas.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="parisdakar-rodas"
VITE_FIREBASE_STORAGE_BUCKET="parisdakar-rodas.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:abcdef0123456789"

# Região das Cloud Functions. São Paulo reduz latência para o público brasileiro.
VITE_FIREBASE_FUNCTIONS_REGION="southamerica-east1"

# Sem estas variáveis o app roda em modo local (localStorage), útil para
# desenvolvimento sem projeto Firebase. Não use assim em produção.

# -----------------------------------------------------------------------------
# Somente para o script de importação server-side (scripts/import-planilha.ts).
# Aponta para o JSON da service account — mantenha o arquivo FORA do git.
# -----------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
