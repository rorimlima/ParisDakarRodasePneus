{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "functions",
    "src/server.ts",
    "src/app.ts",
    "src/index.ts",
    "src/config/security.ts",
    "src/config/firebase.ts",
    "src/config/branding.ts",
    "src/controllers/**/*",
    "src/routes/**/*",
    "src/middlewares/**/*",
    "src/schemas/**/*",
    "src/services/dbClient.ts",
    "src/services/importService.ts",
    "src/services/serverCatalogService.ts",
    "src/services/splitFeeService.ts",
    "src/tests/**/*"
  ]
}
