{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  // Backend e frontend convivem em src/: tudo que roda no navegador fica de fora
  // do build da Cloud Function.
  "exclude": [
    "node_modules",
    "src/**/*.tsx",
    "src/data/**",
    "src/services/storageService.ts",
    "src/services/authService.ts",
    "src/config/firebaseClient.ts",
    "src/vite-env.d.ts",
    "src/tests/**"
  ]
}
