{
  "name": "paris-dakar-rodas-pneus",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma do catálogo Paris Dakar Rodas e Pneus (vitrine Vite/React + backend Express + Firebase)",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:client": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test:rules": "npx firebase-tools emulators:exec --only firestore --project demo-paris-dakar \"node src/tests/firestore.rules.test.mjs\"",
    "emulator": "firebase emulators:start --only firestore --project demo-paris-dakar",
    "importar": "tsx scripts/import-planilha.ts",
    "check:db": "tsx src/scripts/checkDatabase.ts",
    "seed:catalog": "tsx src/scripts/seedCatalog.ts",
    "test:db": "tsx src/tests/testFirestoreRepository.ts",
    "test:auth": "tsx src/tests/testAdminAuthorization.ts",
    "verify:prod": "tsx src/scripts/verifyProduction.ts",
    "set-admin": "tsx src/scripts/setAdminClaim.ts",
    "firebase:emuladores": "firebase emulators:start --only auth,firestore,functions,storage",
    "firebase:regras": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "firebase:functions": "npm --prefix functions run deploy",
    "firebase:deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.3.1",
    "firebase": "^12.17.0",
    "helmet": "^7.1.0",
    "lucide-react": "^0.546.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^13.35.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=20"
  }
}
