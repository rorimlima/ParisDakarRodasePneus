{
  "name": "paris-dakar-rodas-pneus",
  "version": "1.0.0",
  "description": "Plataforma E-commerce Automotivo Paris Dakar Rodas e Pneus com Antigravity e Firebase Auth",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:client": "vite build",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "set-admin": "ts-node src/scripts/setAdminClaim.ts",
    "deploy": "npm run build && firebase deploy --only hosting,functions"
  },
  "keywords": [
    "antigravity",
    "firebase-auth",
    "security",
    "ecommerce",
    "automotive",
    "rbac",
    "upsert",
    "delta-sync"
  ],
  "author": "Paris Dakar Rodas e Pneus",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.1.1",
    "helmet": "^7.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.2"
  }
}

