{
  "name": "paris-dakar-rodas-backend",
  "version": "1.0.0",
  "description": "Backend robusto e seguro para e-commerce automotivo Paris Dakar Rodas e Pneus com Antigravity e Firebase Auth",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "set-admin": "ts-node src/scripts/setAdminClaim.ts",
    "deploy": "npm run build && firebase deploy --only hosting,functions"
  },
  "keywords": [
    "antigravity",
    "firebase-auth",
    "security",
    "ecommerce",
    "automotive",
    "rbac",
    "upsert",
    "delta-sync"
  ],
  "author": "Engenharia de Segurança & Arquitetura de Software Sênior",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.1.1",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
